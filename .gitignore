# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Environments ---
.venv/
venv/
env/
ENV/

# --- Secrets (keep .env.example, never the real one) ---
.env
.env.local
*.pem
*.key

# --- Notebooks ---
.ipynb_checkpoints/
notebooks/**/*-checkpoint.ipynb

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# --- Editors / OS ---
.idea/
*.swp
.DS_Store
Thumbs.db

# VS Code: settings.json and extensions.json ARE committed on purpose, so the
# whole team gets the same interpreter and extension recommendations.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
